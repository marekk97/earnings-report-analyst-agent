# --- Model (Ollama) ---------------------------------------------------------
# Local development (free): run `ollama serve` and pull a tool-capable model.
OLLAMA_HOST=http://localhost:11434
EARNINGS_MODEL=qwen3.5:9b

# Ollama Cloud: point at ollama.com and supply an API key (https://ollama.com/settings/keys).
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your-key
# EARNINGS_MODEL=gpt-oss:120b

EARNINGS_TEMPERATURE=0
EARNINGS_NUM_CTX=32768
EARNINGS_MAX_STEPS=10
# Thinking: true/false (qwen3, deepseek...) or low/medium/high (gpt-oss). Empty = model default.
EARNINGS_REASONING=

# --- SEC EDGAR --------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="EarningsAnalyst your-name@your-domain.com"

# --- Paths ------------------------------------------------------------------
EARNINGS_DATA_DIR=data
EARNINGS_LOG_DIR=logs
EARNINGS_BRIEF_DIR=briefs
